# .env.example - copy to .env and edit before running

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-this-with-a-secure-random-string
# Optional dedicated JWT secret (recommended in production).
# If empty, SECRET_KEY is used.
JWT_SECRET_KEY=

# Postgres (used to construct DATABASE_URL automatically if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional full DATABASE_URL (if set, it will be used instead of the above components)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Background tasks
# redis keeps the legacy Redis-list worker path; celery enables Celery workers.
BACKGROUND_TASKS_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=120
CELERY_TASK_TIME_LIMIT_SECONDS=180
CELERY_TASK_MAX_RETRIES=5
CELERY_WORKER_CONCURRENCY=4

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_PASSWORD=10
RATE_LIMIT_TESTS_READ=1200
RATE_LIMIT_ANSWERS_READ=900
RATE_LIMIT_ANSWERS=180
RATE_LIMIT_ANALYTICS=120
RATE_LIMIT_LEARNING_DASHBOARD=300
RATE_LIMIT_AI=30
RATE_LIMIT_ADMIN=120
RATE_LIMIT_ADMIN_LOGIN=10

# Monitoring
MONITORING_ENABLED=true
# Optional token for /health/metrics access (header: X-Metrics-Token).
# Keep empty for local/dev, set in staging/production.
MONITORING_METRICS_TOKEN=

# Admin panel
ADMIN_ENABLED=true
ADMIN_BASE_URL=/admin
ADMIN_SESSION_MAX_AGE_SECONDS=28800
# Keep false for local http dev. Set true in production (https).
ADMIN_SESSION_HTTPS_ONLY=false
ADMIN_SESSION_SAME_SITE=lax
# Optional dedicated admin session secret (recommended in production).
# If empty, SECRET_KEY is used.
ADMIN_SESSION_SECRET_KEY=
# Optional admin IP allowlist (IPv4/IPv6 and CIDR are supported).
# Example: ADMIN_ALLOWED_IPS=127.0.0.1,10.0.0.0/8,192.168.1.10/32
ADMIN_ALLOWED_IPS=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_BLOCK_SECONDS=900
ADMIN_MFA_ENABLED=false
# Base32 TOTP secret, for example from authenticator app provisioning.
ADMIN_MFA_TOTP_SECRET=
ADMIN_MFA_TOTP_PERIOD_SECONDS=30
ADMIN_MFA_TOTP_DIGITS=6
ADMIN_MFA_TOTP_DRIFT_WINDOWS=1

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where token endpoint lives (used by OAuth2PasswordBearer)
OAUTH2_TOKEN_URL=/api/v1/auth/token

# Hash schemes used by passlib (comma-separated if needed)
HASH_SCHEMES=bcrypt
PASSWORD_POLICY_MIN_LENGTH=10
PASSWORD_POLICY_REQUIRE_UPPERCASE=true
PASSWORD_POLICY_REQUIRE_LOWERCASE=true
PASSWORD_POLICY_REQUIRE_DIGIT=true
PASSWORD_POLICY_REQUIRE_SPECIAL=true
PASSWORD_POLICY_DISALLOW_WHITESPACE=true

# AI gamification (OpenRouter)
AI_GAMIFICATION_ENABLED=false
AI_GAMIFICATION_DAILY_QUOTA_PER_USER=20
AI_GAMIFICATION_MAX_SOURCE_CHARS=12000
AI_GAMIFICATION_JOB_MAX_RETRIES=2
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1:free
# Comma-separated fallback list, example:
# OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-r1:free,qwen/qwen3-coder:free,qwen/qwen3-4b:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-coder:free,qwen/qwen3-4b:free,openrouter/free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
# Optional attribution headers (recommended by OpenRouter):
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=hse-c-sharp-gamification
